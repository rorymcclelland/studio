{
  "name": "campaign-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest --no-discovery",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs --seed",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "eval": "node --env-file-if-exists=.env.local scripts/eval.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "ai": "^7.0.152",
    "inngest": "^4.26.0",
    "next": "16.4.3",
    "opentype.js": "^2.0.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "inngest-cli": "^1.49.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "zod": "$zod"
  }
}
