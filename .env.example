# Copy to .env.local for local development. Never commit real values.

# Postgres. Locally: a plain Postgres built from db/migrations (npm run db:reset).
# On Vercel: Supabase's transaction pooler connection string (port 6543).
DATABASE_URL=postgres://postgres@localhost:54329/campaign_studio_dev

# Who may sign in (comma-separated).
ALLOWED_EMAILS=dev@example.test

# The owner: may invite people (/invites) and is exempt from the per-workspace cap.
# Defaults to the first ALLOWED_EMAILS entry.
OWNER_EMAIL=
# Each other workspace's daily AI limit in pence (under DAILY_CAP_PENCE).
WORKSPACE_DAILY_CAP_PENCE=50

# Sign-in (N-2, N-3): Studio's own sessions and emailed sign-in links.
# Locally, in CI and on previews the link is written to the server log (the
# console mailer). Production sends it through Resend; both of these are set
# in Vercel's Production environment only (RESEND_API_KEY marked Sensitive).
RESEND_API_KEY=
EMAIL_FROM=
# Optional: the address sign-in links point at (defaults to the production
# domain on Vercel, the deployment address on previews, the request locally).
APP_URL=

# Models. MODEL_PROVIDER_OVERRIDE=mock uses the offline mock model, so nothing is spent.
MODEL_PROVIDER_OVERRIDE=mock
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional per-agent override, e.g. AGENT_MODEL_TAGLINE=google:gemini-3.1-flash-lite
# Optional image model override (S5-1; default google:gemini-nano-banana-2.1 at 1K, which needs the Google key)
# IMAGE_MODEL=google:gemini-nano-banana-2.1

# Spend cap in pence per day (default 100 = £1), and the USD to GBP rate for costs.
DAILY_CAP_PENCE=100
USD_TO_GBP=0.79

# Workflows. Locally, INNGEST_DEV=1 and run `npm run inngest`.
# On Vercel, the Inngest integration adds INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY.
INNGEST_DEV=1
# How long approvals stay open (default 7d).
APPROVAL_TIMEOUT=7d
